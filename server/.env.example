PORT=4000

# NOTE: the code reads MONGODB_URI (server/src/config/db.js), not MONGO_URI.
MONGODB_URI=mongodb://localhost:27017/tcams

# Generate a real secret for anything beyond local development, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=8h

# Origin allowed by CORS (server/src/app.js). Falls back to
# http://localhost:5173 for local dev if unset. In production, set this to
# the deployed Vercel frontend URL.
CLIENT_URL=http://localhost:5173
